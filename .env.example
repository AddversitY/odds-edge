# Odds Edge backend settings.
# Copy this file to .env only as a personal note. The server reads the
# environment, not this file. Never commit a real API key.
# The Flutter app does not read this file and must not receive these keys.

# demo = sample prices. the-odds-api = your free The Odds API account.
ODDS_PROVIDER=demo

# Paste the key from https://the-odds-api.com/ after you create a free account.
# Leave this blank while you are using demo mode.
THE_ODDS_API_KEY=

# Up to 10 sportsbook ids. Blank uses 10 major US books:
# draftkings, fanduel, betmgm, williamhill_us, espnbet, fanatics,
# betrivers, hardrockbet, ballybet, fliff.
# A bookmaker list is billed as one region. Do not list more than 10.
ODDS_API_BOOKMAKERS=

# Comma-separated subset of h2h,spreads,totals.
# All three cost 3 credits per snapshot. One market costs 1.
ODDS_API_MARKETS=h2h,spreads,totals

# Stop manual refreshes when fewer than this many credits would be left.
# Scheduled snapshots can still use the reserve. Default 50 of the free 500.
ODDS_CREDIT_RESERVE=50

# Seconds to wait between shared manual refreshes. Default 10 minutes.
# Everyone sees the same cached snapshot during the wait.
ODDS_ON_DEMAND_COOLDOWN_SECONDS=600

# Daily snapshot time in UTC. 15:00 is 11:00am Eastern during daylight time.
ODDS_DAILY_SNAPSHOT_UTC=15:00

# How long before kickoff to refresh. Default: 1 hour and 10 minutes.
ODDS_KICKOFF_LEADS=60m,10m

# If the server was briefly busy, still take a kickoff snapshot this many
# minutes after the planned time.
ODDS_SCHEDULE_GRACE_MINUTES=20

# Planned refreshes this close together become one request.
ODDS_SLOT_COALESCE_MINUTES=10

# How often to re-check kickoff times. That events call is free.
ODDS_EVENTS_REFRESH_HOURS=6

# Book ids whose NFL full-game rules you have actually checked.
# Leave blank until then. Example: fanduel,draftkings
VERIFIED_NFL_RULE_BOOKS=

# Demonstration mode only. Ignored by the free-tier schedule.
# A 60-second poll is not used with a live free key: it would spend
# 500 credits in about 80 minutes.
ODDS_REFRESH_SECONDS=60

# Research assistant. Leave the key blank to keep odds running with the
# assistant unavailable. Only backend/server.dart reads these.
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low

# Upgrade path (do not enable on the free plan):
# The Odds API $30/month plan includes 20,000 credits, enough to refresh
# about every 60 seconds while games are on. Featured markets there update
# about every 60 seconds before kickoff and about every 40 seconds in play.
